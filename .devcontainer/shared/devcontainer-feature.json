{
    "id": "shared",
    "version": "1.0.0",
    "name": "MaxMatrix shared editor configuration",
    "description": "Extensions, the Arduino AVR core, the toolchain sanity check and the volumes for the Arduino data directory and logins shared by every devcontainer.json variant.",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "EditorConfig.EditorConfig",
                "eamodio.gitlens",
                "cschlosser.doxdocgen",
                "openai.chatgpt"
            ],
            // clangd for IntelliSense, from build/compile_commands.json, which it finds
            // on its own; cpptools only for debugging, its IntelliSense off so that the
            // two do not answer twice. No header insertion: an include in src/ names
            // its header by the path from src/, which the editor would not know. An
            // .ino is C++, and the simulator compiles each into the database.
            // doxdocgen writes the skeleton of a Doxygen block, see the settings below.
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.path": "/usr/bin/clangd",
                "clangd.arguments": ["--header-insertion=never"],
                "files.associations": { "*.ino": "cpp" },
                // The skeleton of a Doxygen block in the style of docu/Documentation.md:
                // /*! and Enter above a declaration.
                "doxdocgen.c.triggerSequence": "/*!",
                "doxdocgen.c.firstLine": "/*!",
                "doxdocgen.c.commentPrefix": " * ",
                "doxdocgen.c.lastLine": " */",
                "doxdocgen.generic.briefTemplate": "\\brief {text}",
                "doxdocgen.generic.paramTemplate": "\\param[in] {param} ",
                "doxdocgen.cpp.tparamTemplate": "\\tparam {param} ",
                "doxdocgen.generic.returnTemplate": "\\return ",
                "doxdocgen.generic.includeTypeAtReturn": false,
                "doxdocgen.generic.order": ["brief", "empty", "tparam", "param", "return"]
            }
        }
    },
    "containerEnv": {
        "GH_HOST": "github.com"
    },
    "postCreateCommand": "arduino-cli core update-index && arduino-cli core install arduino:avr && arduino-cli version && arduino-lint --version && gh --version && clangd --version && cmake --preset default",
    "mounts": [
        {
            "source": "maxmatrix-arduino15",
            "target": "/home/vscode/.arduino15",
            "type": "volume"
        },
        {
            "source": "maxmatrix-codex",
            "target": "/home/vscode/.codex",
            "type": "volume"
        },
        {
            "source": "maxmatrix-gh",
            "target": "/home/vscode/.config/gh",
            "type": "volume"
        }
    ]
}
