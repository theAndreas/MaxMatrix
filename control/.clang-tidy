# The checks of the root's .clang-tidy, less one that argues with wxWidgets.
#
# bugprone-suspicious-enum-usage
#   Reports every flag combination of a sizer, wxEXPAND | wxALL: wxWidgets declares the
#   stretch, the border and the alignment as enums of their own and has them or-ed into one
#   int, on purpose. A NOLINT on every Add() would hide a real finding among them.
#
# clang-diagnostic-enum-enum-conversion
#   The same flags, as clang's warning reports them; CMakeLists.txt here turns it off for the
#   window.
#
# cppcoreguidelines-owning-memory
#   Reports every new of a control: wxWidgets hands it to the parent it is made with, which
#   deletes it, so the window owns no pointer it could free. The classes without a window
#   allocate nothing.
InheritParentConfig: true
Checks: >
  -bugprone-suspicious-enum-usage,
  -clang-diagnostic-enum-enum-conversion,
  -cppcoreguidelines-owning-memory
