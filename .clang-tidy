# What static analysis is asked for here, and what it is not; the same choice as Wordclock's.
#
# The checks that are on are the ones that answer "is this wrong": the bug patterns, the
# path-sensitive analyser, the CERT rules and the performance ones. The ones that are off
# argue with decisions this project has already made, and a check that is answered by
# "no, on purpose" every time is a check nobody reads.
#
# Of the style checks only three: whether a member function can be static or const, and
# Google's names, which readability-identifier-naming checks with the same options as Utl and
# Wordclock, so that every project names alike. The modernize- family stays off: it would
# report every configuration macro.
#
# Run over the host build's compile database, which covers the library in all three variants
# of the tests, and the simulator:
#
#   cmake --preset default
#   run-clang-tidy -p build -quiet "$PWD/(src|simulator)/"
#
# and over the Uno's, through tools/cross_clang_tidy.py: the same checks, with the database
# rewritten so that clang can read what avr-gcc was told, where an int has 16 bits:
#
#   arduino-cli compile --fqbn arduino:avr:uno --library . --only-compilation-database \
#                       --build-path build/avr examples/SerialControl
#   python3 tools/cross_clang_tidy.py build/avr "$PWD/src/"
#
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  performance-*,
  readability-convert-member-functions-to-static,
  readability-make-member-function-const,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -bugprone-too-small-loop-variable,
  -cert-err33-c,
  -cert-err58-cpp

# Why each of those is off:
#
# bugprone-easily-swappable-parameters
#   Reports every pair of coordinates, ConvertDotToBuffer(byte column, byte row, ...), and
#   the three pins of MaxMatrixChain. The answer would be a type per coordinate and per pin,
#   which is not what this library is; the parameters are named and documented.
#
# bugprone-too-small-loop-variable
#   A byte counting the columns, while MAXMATRIX_NUMBER_OF_COLUMNS is an int. The check
#   reads the types, not the values: max_matrix_config.h asserts that the columns fit into a
#   byte, which every index into matrix_buffer_ relies on, not only the loops.
#
# cert-err33-c
#   Reports the simulator's prints to the terminal and its snprintf() into buffers that are
#   large enough. A simulator that cannot print has nobody to tell; the library calls none
#   of the functions the rule lists.
#
# cert-err58-cpp
#   Reports the simulator's static objects, which a sketch has as well: a static object
#   whose constructor could throw. Nothing here throws, and the library is built without
#   exceptions on the board.

# A finding can be reported under several names at once, a bugprone- check and the CERT
# rules that alias it, and which of them leads depends on the version. A NOLINT therefore
# names all of them.
#
# Only what this repository owns: the headers of src/ and simulator/, not the mock of the
# Arduino core in test/mock/, which stands in for code that is not ours either. The leading
# slash keeps a directory that merely ends in src from matching.
HeaderFilterRegex: '/(src|simulator)/'
WarningsAsErrors: '*'
CheckOptions:
  # Google's names. Exceptions: setup() and loop(), which Arduino calls by them, and the
  # stand-ins of test/mock/ for the Arduino core, which carry a NOLINT; an include guard ends
  # in an underscore.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassIgnoredRegexp: '^(array|span|optional|basic_string_view|string_view|basic_flash_string_view|flash_string_view|const_iterator|iterator)$'
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.StructIgnoredRegexp: '^(array|nullopt_t|is_[a-z_]+|remove_[a-z_]+|enable_if|integral_constant|true_type|false_type)$'
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.FunctionIgnoredRegexp: '^(setup|loop)$'
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: _
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^(npos|nullopt|value)$'
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.StaticConstantCase: CamelCase
  readability-identifier-naming.StaticConstantPrefix: k
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '^[A-Z][A-Z0-9_]*_$'
